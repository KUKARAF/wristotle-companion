<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The companion bridges to a connected wearable (Pebble watch via
         rePebble / microPebble). `connectedDevice` is the semantically
         correct FGS type and, unlike `dataSync`, has no per-app daily
         time budget on Android 14+ — `dataSync` was burning through its
         ~6 h/day quota during heavy dev iteration and crashing onCreate
         with ForegroundServiceStartNotAllowedException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required by the FGS-type-CONNECTED_DEVICE validator on Android
         14+: an app declaring "I'm running a foreground service for a
         connected device" must also hold at least one paired hardware
         permission (BLUETOOTH_CONNECT / NFC / USB host / etc). NFC is
         normal-protection so it satisfies the validator with no
         runtime prompt and no user-visible permission entry. We don't
         actually use NFC; the real Pebble-BLE link runs inside the
         rePebble companion app's process, which holds the real
         Bluetooth permissions. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".WristotleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wristotle" >

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wristotle" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchMessageService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".service.PebbleListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>

    </application>

</manifest>
