<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Set phone alarms / timers via the system clock app (AlarmClock
         intents). Normal permission, auto-granted at install — no runtime
         prompt. Required for ACTION_SET_ALARM / ACTION_SET_TIMER. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Persistent reminders re-fire on the phone after the watch timeline pin
         fires, at user-configured intervals. Exact alarms keep the
         "remind me at 3pm" promise tight under Doze:
           - USE_EXACT_ALARM: auto-granted on Android 13+ for true
             alarm-clock-shaped apps (reminder / timer / calendar);
           - SCHEDULE_EXACT_ALARM: revocable fallback for 12-and-older.
         RECEIVE_BOOT_COMPLETED lets PersistentReminderBootReceiver re-arm
         the AlarmManager schedule after a device reboot (AlarmManager wipes
         pending alarms on shutdown). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Boost the alarm-stream volume + vibrate while ringing for find-my-phone. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The companion bridges to a connected wearable (Pebble watch via
         rePebble / microPebble). `connectedDevice` is the semantically
         correct FGS type and, unlike `dataSync`, has no per-app daily
         time budget on Android 14+ — `dataSync` was burning through its
         ~6 h/day quota during heavy dev iteration and crashing onCreate
         with ForegroundServiceStartNotAllowedException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required by the FGS-type-CONNECTED_DEVICE validator on Android
         14+: an app declaring "I'm running a foreground service for a
         connected device" must also hold at least one paired hardware
         permission (BLUETOOTH_CONNECT / NFC / USB host / etc). NFC is
         normal-protection so it satisfies the validator with no
         runtime prompt and no user-visible permission entry. We don't
         actually use NFC; the real Pebble-BLE link runs inside the
         rePebble companion app's process, which holds the real
         Bluetooth permissions. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Coarse location (~3 km accuracy) for bare "what's the weather"
         queries — the handler reads the phone's last-known location and
         fetches that point's current conditions. Optional: if denied,
         the user can still ask "weather in <city>" and everything else
         keeps working. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Optional "Display over other apps" permission. Wristotle never
         actually draws an overlay — holding the grant alone is what gets us
         BAL_ALLOW_SAW_PERMISSION in Android's BackgroundActivityStartController,
         which exempts our startActivity() calls from the Android 14+ BAL
         restriction. Without this, watch-triggered `open <app>` reliably fails
         on cold-state because PebbleListenerService runs in BOUND_FGS state.
         User-grantable via Settings → Special access → Display over other apps;
         the PermissionsScreen surfaces a Grant button. The fallback (no grant)
         remains intact — without the grant we just hit the same wall we have
         today. See project_watch_launch_bal_wall memory + apps-and-media.md
         for the full BAL investigation history. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Required on Android 11+ so PackageManager.queryIntentActivities
         returns all installed launcher apps, not just the ones with
         existing interaction visibility. The AppIndexer uses this to
         build the index that powers `open <app>` and `play <app>`
         voice commands. The Settings "Scan installed apps" button is
         the only entry point that touches it; we never run package
         enumeration on every voice command. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".WristotleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wristotle"
        android:usesCleartextTraffic="true" >

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wristotle" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- notes.osmosis.page sign-in (WebView catches the token redirect). -->
        <activity
            android:name=".notesserver.NotesServerLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Wristotle" />

        <!-- Browser-login fallback: receives rust_note's app redirect. Disabled
             until the user picks "log in with browser", then disabled again,
             so it never competes with the rust-note app for this scheme. -->
        <activity
            android:name=".notesserver.NotesServerRedirectActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.rustnote.app" android:host="auth" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchMessageService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".service.PebbleListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>

        <!-- Empty NotificationListenerService whose only role is to exist
             — its presence + Notification Access grant unlocks
             MediaSessionManager.getActiveSessions() for our process. See
             media/MediaSessionsListener.kt. The android:permission
             attribute is required by the platform for any service
             declaring this intent-filter; without it the service won't
             bind. -->
        <service
            android:name=".media.MediaSessionsListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Persistent reminders: internal fire + Stop-action receiver.
             exported=false because the broadcasts are always sent with
             an explicit component name from inside the app — no external
             entry point should be able to synthesise them. -->
        <receiver
            android:name=".handlers.persistent.PersistentReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lazydevs.wristotle.PERSISTENT_REMINDER_FIRE" />
                <action android:name="com.lazydevs.wristotle.PERSISTENT_REMINDER_STOP" />
            </intent-filter>
        </receiver>

        <!-- Stop action for the find-my-phone ringer. Internal only. -->
        <receiver
            android:name=".findphone.FindPhoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lazydevs.wristotle.FIND_PHONE_STOP" />
            </intent-filter>
        </receiver>

        <!-- Boot recovery: re-arms persistent-reminder alarms after device
             restart. exported=true is required because BOOT_COMPLETED is a
             system broadcast; kept in a separate receiver from the fire /
             stop entry points so those stay internal-only. -->
        <receiver
            android:name=".handlers.persistent.PersistentReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Barcode/QR scanner pinned to portrait (zxing-embedded defaults to
             landscape). Used via ScanOptions.setCaptureActivity(...). -->
        <activity
            android:name=".codes.PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

    </application>

</manifest>
