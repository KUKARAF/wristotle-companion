# Optional local override for release signing — copy to keystore.properties
# (gitignored) and point the storeFile path at your keystore. CI uses env
# vars instead; this file is only for `./gradlew :app:assembleRelease`
# locally on your dev machine.

storeFile=/absolute/path/to/wristotle-release.keystore
storePassword=changeme
keyAlias=wristotle
keyPassword=changeme
