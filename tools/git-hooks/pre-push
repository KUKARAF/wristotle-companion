#!/bin/sh
# pre-push — refuse tag pushes that don't match this repo's expected version
# series. Defends against the "tagged the wrong repo" mistake that produced
# orphan v0.7.0 and v0.8.1 releases on the watch repo.
#
# This file is the canonical hook — checked into the repo so contributors
# share it. Wire it into your clone once with:
#
#   git config core.hooksPath tools/git-hooks
#
# After that, edits to this file take effect on the next push (no need to
# also copy into .git/hooks/). See README → "Git hooks" for setup.
#
# Bumping the major/minor: update ALLOWED below in the SAME commit as the
# release, then push the new tag. The patch series stays open.
#
# To bypass for a one-off (e.g. tagging an emergency hotfix outside the
# series): git push --no-verify origin <tag>

set -e

# Tag pattern allowed for this (companion) repo. Current series: v1.0.x.
ALLOWED='^v1\.0\.[0-9]+$'

remote="$1"
url="$2"

HELP_CONTENT="app/src/main/java/com/lazydevs/wristotle/help/HelpTimeline.kt"
FEATURES_JSON="data/features.json"

while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*)
            tag_name=${remote_ref#refs/tags/}
            case "$tag_name" in
                v[0-9]*.[0-9]*.[0-9]*)
                    if ! echo "$tag_name" | grep -qE "$ALLOWED"; then
                        cat >&2 <<EOF

✗ pre-push: refusing to push tag '$tag_name' to $url
  This repo (companion) accepts tags matching $ALLOWED
  Likely cause: tagged the wrong repo. Tag landed in the companion
  repo but the watch or some other repo was probably intended.

  If this is a legitimate series bump, edit ALLOWED in:
    .git/hooks/pre-push
  to match the new pattern.

  To bypass for a one-off: git push --no-verify origin $tag_name

EOF
                        exit 1
                    fi

                    # Soft warning: tag has no corresponding feature in the
                    # generated HelpTimeline.kt (sourced from data/features.json).
                    # Internals-only releases (refactor / tests / CI / build)
                    # intentionally don't get one — read the warning and
                    # decide. Doesn't block the push; the
                    # `memory/feedback_helpcontent_sync_before_tag` rule
                    # spells out the decision criteria.
                    if [ -f "$HELP_CONTENT" ] && ! grep -q "Version = \"$tag_name\"" "$HELP_CONTENT"; then
                        cat >&2 <<EOF

⚠ pre-push: tag '$tag_name' is not listed in $HELP_CONTENT
  Decide:
    - User-facing release? Cancel the push (Ctrl-C), then:
        1. Add an entry to wristotle-docs/data/features.json (newest first).
        2. Run: tools/sync_features.sh && python3 tools/regenerate_help_timeline.py
        3. Commit features.json + the regenerated HelpTimeline.kt.
        4. Re-tag at the new commit and push.
    - Internals-only release (refactor / tests / CI / build / fix)?
      Ignore — the editorial filter is the whole point of the page.
  See memory/feedback_helpcontent_sync_before_tag for the convention.

EOF
                    fi

                    # Freshness check: HelpTimeline.kt MUST match what
                    # the codegen would produce from data/features.json.
                    # Stale Kotlin = wrong Help page in the next build,
                    # and the regen is one deterministic command. Hard
                    # refusal — there's no legitimate "yes, ship this
                    # stale on purpose" state. Bypass with --no-verify
                    # only if python3 is unavailable on the host.
                    if [ -f "$FEATURES_JSON" ] && command -v python3 >/dev/null 2>&1; then
                        if ! python3 tools/regenerate_help_timeline.py --check >/dev/null 2>&1; then
                            cat >&2 <<EOF

✗ pre-push: $HELP_CONTENT is out of sync with $FEATURES_JSON
  Run: python3 tools/regenerate_help_timeline.py
  Then commit the regenerated file and push again.

  To bypass (e.g. python3 unavailable): git push --no-verify

EOF
                            exit 1
                        fi
                    fi

                    # Soft warning: the static versionName in
                    # app/build.gradle.kts (the fallback used when
                    # WRISTOTLE_VERSION_NAME isn't set) MUST track the
                    # tag being pushed. F-Droid's scanner reads this
                    # static value (no env vars available in their
                    # build environment), so a stale fallback means
                    # F-Droid would publish a stale version on the
                    # next scan.
                    #
                    # Same idea as the watch's package.json bump rule.
                    # Compare just the numeric part of the tag (`v1.0.1`
                    # → `1.0.1`) against the literal in build.gradle.kts.
                    expected_name="${tag_name#v}"
                    static_name=$(sed -n 's/.*WRISTOTLE_VERSION_NAME.*?: *"\([^"]*\)".*/\1/p' app/build.gradle.kts 2>/dev/null | head -1)
                    if [ -n "$static_name" ] && [ "$static_name" != "$expected_name" ]; then
                        cat >&2 <<EOF

⚠ pre-push: tag '$tag_name' but app/build.gradle.kts versionName fallback is '$static_name'
  F-Droid's scanner reads the static fallback value (not the CI env
  override), so a mismatch means F-Droid would publish a stale
  versionName on the next scan.

  To fix:
    1. Edit app/build.gradle.kts → versionName fallback to "$expected_name"
       (and bump versionCode to match per the 2-digits-per-component
       scheme: $expected_name → $(echo "$expected_name" | awk -F. '{printf "%d%02d%02d", $1, $2, $3}'))
    2. Commit and re-tag at the new commit.
    3. Push.

  Bypass for a one-off (non-F-Droid release): git push --no-verify origin $tag_name

EOF
                    fi
                    ;;
            esac
            ;;
    esac
done

exit 0
